generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["edusphere_platform"]
}

model PlatformUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("platform_admin")
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_users")
  @@schema("edusphere_platform")
}

model SchoolTenant {
  id          String      @id @default(cuid())
  name        String
  code        String?     @unique @map("tenant_code")
  tenantType  String      @default("school") @map("tenant_type")
  workspaceUrl String     @unique @map("workspace_url")
  status      String      @default("active")
  planName    String?     @map("plan_name")
  details     Json?
  officialEmail String? @unique @map("official_email")
  adminPasswordHash String? @map("admin_password_hash")
  passwordSetupTokenHash String? @unique @map("password_setup_token_hash")
  passwordSetupExpiresAt DateTime? @map("password_setup_expires_at")
  passwordSetAt DateTime? @map("password_set_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@map("school_tenants")
  @@schema("edusphere_platform")
}

model TenantCodeCounter {
  id         String   @id @default(cuid())
  tenantType String   @map("tenant_type")
  year       Int
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantType, year])
  @@map("tenant_code_counters")
  @@schema("edusphere_platform")
}
