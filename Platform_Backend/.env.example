NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/edusphere_platform?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PLATFORM_ADMIN_NAME=Platform Administrator
PLATFORM_ADMIN_EMAIL=admin@edusphere.com
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# SMTP credentials for sending organization password setup links
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=EduSphere <your-sender@gmail.com>
FRONTEND_URL=http://localhost:5173
