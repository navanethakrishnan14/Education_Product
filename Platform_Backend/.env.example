NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/school_product
DATABASE_SSL=false
PG_POOL_MAX=10
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_second_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000
SAAS_ADMIN_NAME=Platform Admin
SAAS_ADMIN_EMAIL=admin@example.com
SAAS_ADMIN_PASSWORD=
SAAS_ADMIN_FORCE_PASSWORD_RESET=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
