NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/edusphere_tenant
# For stable local tokens, replace this placeholder with a random secret of 32+ characters.
# If left unchanged in development, the backend generates a temporary secret at startup.
# Production requires a real secret and never uses the development fallback.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
