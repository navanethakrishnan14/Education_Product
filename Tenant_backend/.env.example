NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/edusphere_tenant
# Keep this secret private; it must be at least 32 characters in production.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
# Must exactly match Platform_Backend JWT_SECRET. Used only to verify Platform Management sessions.
PLATFORM_JWT_SECRET=replace_with_the_exact_platform_jwt_secret_here
# REQUIRED for Platform Management Organization Profile: reads registered identity/type/status from Platform.
# Must point to the Platform PostgreSQL database (edusphere_platform), NOT the Tenant database.
# Keep this server-side only; never use a VITE_ prefix or commit real credentials.
PLATFORM_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/edusphere_platform
PLATFORM_DATABASE_SSL=false
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
